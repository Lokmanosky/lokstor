rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Product images: readable by all, writable by any authenticated user
    // (Admin-only access is enforced by the admin panel authentication itself)
    // Product images: readable by all, writable by admin only
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
             request.auth.token.email_verified == true && 
             request.auth.token.email.lower() == 'loktech.dz@gmail.com' &&
             request.resource.size < 5 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    // Private Digital Files:
    // Downloadable exclusively via Signed URLs generated server-side after payment.
    match /products/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
