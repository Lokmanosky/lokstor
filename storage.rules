rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Public product images: readable by all, writeable only by Admin
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Private Digital Files (PDFs, ZIPs, Courses):
    // Direct client access blocked (allow read, write: if false;).
    // Downloadable exclusively via Signed URLs generated server-side by Firebase Admin SDK after payment verification.
    match /products/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
