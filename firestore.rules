rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Helper: isAdmin ==========
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ========== 1. Users ==========
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ========== 2. Products ==========
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========== 3. Orders ==========
    // Admins can read/write all.
    // Authenticated users can read their OWN orders (by email OR userId).
    // Writes from clients are allowed only to create (checkout flow creates order then redirects to payment).
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        ));
      // Allow clients to create orders (the checkout page creates order before redirecting to payment gateway)
      allow create: if request.auth != null;
      // Only server (admin SDK) can update/delete orders
      allow update, delete: if false;
    }

    // ========== 4. Store Settings ==========
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== 5. Banners & Categories ==========
    match /storeBanners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /storeCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== 6. Reviews ==========
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    // ========== 7. Notifications ==========
    match /notifications/{id} {
      allow read, write: if isAdmin();
    }

    // ========== 8. Analytics & Presence ==========
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /active_users/{userId} {
      allow read: if isAdmin();
      allow write: if true;
    }

    // ========== 9. Rate Limits (server-side only) ==========
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ========== Fallback: deny everything else ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
