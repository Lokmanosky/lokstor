rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email_verified == true && 
             request.auth.token.email.lower() == 'loktech.dz@gmail.com';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId && !('role' in request.resource.data) && !('isAdmin' in request.resource.data) && !('balance' in request.resource.data);
      allow update: if (request.auth != null && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'name', 'phone', 'photoURL', 'updatedAt', 'fcmToken'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /productUnits/{id} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /settings/store {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/private {
      allow read, write: if isAdmin();
    }

    match /storeBanners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /storeCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'productId', 'rating', 'comment', 'createdAt', 'userName', 'status'])
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read, write: if isAdmin();
    }

    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /active_users/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
