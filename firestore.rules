rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Helper: isAdmin ==========
    // Simple email check — matches how auth-context.tsx determines admin
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email == 'loktech.dz@gmail.com';
    }

    function isOwnerOrAdmin(uid) {
      return request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ========== 1. Users ==========
    match /users/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isOwnerOrAdmin(userId);
      allow delete: if isAdmin();
    }

    // ========== 2. Products ==========
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========== 3. Orders ==========
    match /orders/{orderId} {
      // Admin sees all. Customer sees their own orders by email or userId.
      allow read: if isAdmin() ||
        (request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        ));
      // Any logged-in user can create an order (checkout flow)
      allow create: if request.auth != null;
      // Only server (Firebase Admin SDK via API routes) can update/delete
      allow update, delete: if false;
    }

    // ========== 4. Store Settings ==========
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== 5. Banners & Categories ==========
    match /storeBanners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /storeCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== 6. Reviews ==========
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    // ========== 7. Notifications ==========
    match /notifications/{id} {
      allow read, write: if isAdmin();
    }

    // ========== 8. Analytics & Presence ==========
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /active_users/{userId} {
      allow read: if isAdmin();
      allow write: if true;
    }

    // ========== 9. Rate Limits (server-side only) ==========
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ========== Fallback: deny everything else ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
