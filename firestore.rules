rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Helper: isAdmin ==========
    // Checks the users collection directly (matches how the app code works)
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ========== 1. Users ==========
    // Users can read/update their own profile. Admins can read/write all.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ========== 2. Products ==========
    // Anyone can read. Only admins can write.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========== 3. Orders ==========
    // Admins can read all. Customers can only read their own.
    // No direct client writes (go through server API routes).
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ========== 4. Store Settings ==========
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== 5. Banners & Categories ==========
    match /storeBanners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /storeCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== 6. Reviews ==========
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    // ========== 7. Notifications ==========
    match /notifications/{id} {
      allow read, write: if isAdmin();
    }

    // ========== 8. Analytics & Presence ==========
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /active_users/{userId} {
      allow read: if isAdmin();
      allow write: if true;
    }

    // ========== 9. Rate Limits (server-side only) ==========
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ========== Fallback: deny everything else ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
